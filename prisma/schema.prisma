generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Player accounts -------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  displayName   String
  walletAddress String? // collected lazily, only required once a user actually wins something (see Payout)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // sha256 of the raw cookie token; raw token is never stored
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Email-keyed (unlike the admin's IP-keyed LoginAttempt below) because user
// login is credential-stuffing-against-a-specific-victim territory -- the
// lockout has to follow the targeted account. A coarse IP rate-limit lives
// at the route level as a secondary guard.
model UserLoginAttempt {
  email       String    @id
  failCount   Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// --- Cricket domain (all seeded/mock data, no external data feed) ----------

model Team {
  id        String   @id @default(cuid())
  name      String
  shortName String
  logo      String
  createdAt DateTime @default(now())

  // The real-world squad's captain/vice-captain -- plain Player id strings,
  // same convention as FantasyTeam.captainId/viceCaptainId (no Prisma
  // relation directive either, for the same reason: this is descriptive
  // display data, not something queried through). Nullable so a team
  // seeded before this existed doesn't need a backfill to stay valid.
  captainPlayerId      String?
  viceCaptainPlayerId  String?
}

model Player {
  id           String   @id @default(cuid())
  name         String
  teamId       String
  role         String // WK | BAT | BOWL | AR
  creditValue  Decimal  @db.Decimal(3, 1) // 7.0-10.5, seeded, correlated with skill
  battingSkill Int
  bowlingSkill Int
  photo        String?
  createdAt    DateTime @default(now())
}

model Match {
  id                   String    @id @default(cuid())
  team1Id              String
  team2Id              String
  venue                String
  format               String    @default("T20")
  scheduledAt          DateTime
  status               String    @default("UPCOMING") // UPCOMING | LIVE | COMPLETED
  currentEventSequence Int       @default(0) // live cursor into MatchEvent, advanced by the admin Advance control or lib/live-advance.ts's autoAdvanceIfDue
  totalEvents          Int       @default(0)
  winnerTeamId         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Pacing clock + CAS guard for lib/live-advance.ts's autoAdvanceIfDue.
  lastAdvancedAt DateTime?
}

// Pre-generated ball-by-ball log, written once by lib/match-simulator.ts at
// seed time. "Live" is just progressively revealing these in sequence order.
model MatchEvent {
  id                String  @id @default(cuid())
  matchId           String
  sequence          Int
  innings           Int
  over              Int
  ballInOver        Int
  battingTeamId     String
  bowlingTeamId     String
  batsmanId         String
  nonStrikerId      String
  bowlerId          String
  runsScored        Int     @default(0)
  isWide            Boolean @default(false)
  isNoBall          Boolean @default(false)
  isWicket          Boolean @default(false)
  dismissalType     String?
  dismissedPlayerId String?
  fielderId         String?
  assistFielderId   String?

  @@unique([matchId, sequence])
}

// Aggregate stat line per player per match, recomputed incrementally as
// MatchEvents are revealed. fantasyPoints is the source of truth the
// leaderboard reads -- see lib/scoring.ts.
model PlayerPerformance {
  id             String   @id @default(cuid())
  matchId        String
  playerId       String
  runs           Int      @default(0)
  ballsFaced     Int      @default(0)
  fours          Int      @default(0)
  sixes          Int      @default(0)
  isOut          Boolean  @default(false)
  dismissalType  String?
  oversBowled    Decimal  @default(0) @db.Decimal(4, 1)
  runsConceded   Int      @default(0)
  wickets        Int      @default(0)
  bowledOrLbwWickets Int  @default(0) // subset of `wickets` that were BOWLED/LBW -- scoring.ts's per-dismissal bonus needs this breakdown, which the aggregate `wickets` count alone can't provide
  maidens        Int      @default(0)
  catches        Int      @default(0)
  stumpings      Int      @default(0)
  runOutsDirect  Int      @default(0)
  runOutsAssist  Int      @default(0)
  fantasyPoints  Decimal  @default(0) @db.Decimal(6, 1)
  updatedAt      DateTime @updatedAt

  @@unique([matchId, playerId])
}

// --- Leagues & contests ------------------------------------------------------

model League {
  id            String   @id @default(cuid())
  name          String
  matchId       String
  creatorId     String
  inviteCode    String   @unique
  entryFeeCents Int      @default(0)
  maxMembers    Int      @default(20)
  status        String   @default("OPEN") // OPEN | LOCKED | COMPLETED
  createdAt     DateTime @default(now())
}

model Contest {
  id              String   @id @default(cuid())
  matchId         String
  name            String
  entryFeeCents   Int
  maxEntries      Int
  currentEntries  Int      @default(0)
  prizePoolCents  Int
  rakeBps         Int      @default(1500) // 15%
  minEntriesToRun Int      @default(3)
  roleBonusBps    Int      @default(0) // bps of prizePoolCents carved out for the 4 Robinhood Chain role bonuses; 0 = feature off, zero behavior change
  status          String   @default("OPEN") // OPEN | LOCKED | LIVE | COMPLETED | FINALIZED | VOIDED
  createdAt       DateTime @default(now())

  // True when this contest FINALIZED with fewer paid entries than
  // minEntriesToRun (but at least one) -- see lib/contest-finalization.ts's
  // settleContestByFallback. Entries aren't ranked by fantasy points in
  // this case; each is settled as a captain's-team win/lose bet instead, at
  // odds from the same engine live match-winner betting already uses.
  fallbackSettled Boolean  @default(false)
}

// --- Fantasy teams -----------------------------------------------------------

model FantasyTeam {
  id            String              @id @default(cuid())
  userId        String
  matchId       String
  name          String              @default("My Team")
  captainId     String
  viceCaptainId String
  totalCredits  Decimal             @db.Decimal(4, 1)
  totalPoints   Decimal             @default(0) @db.Decimal(6, 1)
  players       FantasyTeamPlayer[]
  contestEntries ContestEntry[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model FantasyTeamPlayer {
  id            String      @id @default(cuid())
  fantasyTeamId String
  fantasyTeam   FantasyTeam @relation(fields: [fantasyTeamId], references: [id])
  playerId      String

  @@unique([fantasyTeamId, playerId])
}

model ContestEntry {
  id                String   @id @default(cuid())
  userId            String
  contestId         String?
  leagueId          String?
  fantasyTeamId     String
  fantasyTeam       FantasyTeam @relation(fields: [fantasyTeamId], references: [id])
  entryFeeCents     Int
  coinvoyageOrderId String?
  paymentUrl        String? // CoinVoyage checkout link, persisted so a resumed/retried entry can return the same link (CoinVoyage has no "fetch invoice by id" call to regenerate it)
  // "NONE" until a CoinVoyage order exists (free entry, or not yet paid);
  // once one does, the real CoinVoyage OrderStatus value (see
  // lib/order-status.ts) -- not a simplified mapping, so isOrderStatus()/
  // isTerminalStatus() work directly on this field like every other app.
  paymentStatus     String   @default("NONE")
  lastEventAt       DateTime? // out-of-order webhook/poll delivery guard, same pattern as coinflip-site's Bet.lastEventAt
  slotClaimed       Boolean  @default(false) // true once this entry has claimed a Contest.currentEntries slot -- the exactly-once release guard in lib/contest-fulfillment.ts (mirrors dental-site's Order.stockReserved)
  rank              Int?
  prizeCents        Int      @default(0)
  idempotencyKey    String?  @unique
  testnetPaymentTxHash String? @unique // set once a payWithTestnetEth entry fee is confirmed on-chain; unique so the same real transaction can never confirm two different entries
  createdAt         DateTime @default(now())

  // Top-3 prize claim -- set only for a winning entry whose OWN entry fee
  // was paid in testnet ETH (testnetPaymentTxHash is set); same
  // fields-on-the-model convention as LiveBet's claim* columns, self-serve
  // on-chain via the same RoleBonusClaim.sol contract/operator signature
  // mechanism. A CoinVoyage-paid winner's prize still goes through Payout
  // (this app has no automated payout path for real money) -- see
  // lib/contest-finalization.ts for which branch a winner takes.
  claimId            String?    @unique
  claimAmountWei     String?
  claimWalletAddress String?
  claimTxHash        String?
  claimedAt          DateTime?

  @@unique([contestId, userId])
  @@unique([leagueId, userId])
}

// --- Money ledger -----------------------------------------------------------
// Same shape as coinflip-site's Payout model, with one deliberate deviation:
// chain/token/walletAddress are nullable here. coinflip-site collects a
// wallet at bet-placement time (a bet always needs to know where winnings
// go), so its Payout row is always born with real values. This app collects
// User.walletAddress lazily -- only once someone actually wins (see
// lib/contest-finalization.ts) -- so a Payout row can genuinely exist before
// those details are known. Null means "awaiting the winner," not "unset by
// mistake"; the admin payout queue (Phase 8) must treat a null
// walletAddress as not-yet-payable, not as an empty string to send to.

model Payout {
  id              String    @id @default(cuid())
  contestEntryId  String?   @unique // exactly one of contestEntryId/liveBetId is ever set, enforced in code not a DB constraint (this schema has none anywhere)
  liveBetId       String?   @unique
  amountOwedCents Int
  chain           String?
  token           String?
  walletAddress   String?
  status          String    @default("PENDING") // PENDING | PAID
  txNote          String?
  createdAt       DateTime  @default(now())
  paidAt          DateTime?
}

// --- Live match-winner betting (separate from fantasy contests entirely) --

model LiveBet {
  id                   String    @id @default(cuid())
  matchId              String
  userId               String
  sideTeamId           String // Match.team1Id or team2Id
  stakeCents           Int
  oddsMultiplier       Decimal   @db.Decimal(4, 2) // locked in at placement time, not recomputed at settlement
  coinvoyageOrderId    String?
  paymentUrl           String? // CoinVoyage checkout link, persisted so an idempotent replay can return the same link (CoinVoyage has no "fetch invoice by id" call to regenerate it)
  quotedTestnetAmountWei String? // testnet-ETH amount quoted at placement, persisted so confirm-testnet-payment checks the rate the user actually saw, not whatever Settings.robinhoodCentsPerTestnetEth is at confirm time
  testnetPaymentTxHash String?   @unique
  status               String    @default("NONE") // lib/order-status.ts vocabulary, same as ContestEntry.paymentStatus
  lastEventAt          DateTime?
  idempotencyKey       String?   @unique
  outcome              String? // WON | LOST | VOID
  payoutCents          Int       @default(0)
  claimId              String?   @unique // testnet-ETH winners only
  claimAmountWei       String? // BigInt-safe as string, same convention as RoleBonusClaim.amountWei
  claimWalletAddress   String? // collected lazily at first voucher request, same convention as RoleBonusClaim.walletAddress
  claimTxHash          String?
  claimedAt            DateTime?
  createdAt            DateTime  @default(now())
  settledAt            DateTime?

  @@index([matchId])
  @@index([userId])
}

// --- Robinhood Chain role-bonus payouts (separate from CoinVoyage, opt-in
// per contest via Contest.roleBonusBps) -----------------------------------

// One row per role bonus a contest actually awards -- the off-chain source
// of truth for "this bonus exists," mirroring how Payout is already the
// off-chain source of truth for CoinVoyage payouts. walletAddress is
// nullable for the same reason as Payout.walletAddress above: collected
// lazily at claim time, never known up front.
model RoleBonusClaim {
  id             String    @id @default(cuid())
  contestId      String
  contestEntryId String
  role           String // WK | BAT | BOWL | AR
  playerId       String // winning contribution's player, for display/audit
  claimId        String    @unique // bytes32 hex, keccak256(contestId, role) -- computed identically on- and off-chain
  amountWei      String // BigInt-safe as string; Prisma has no native uint256
  walletAddress  String?
  status         String    @default("DECLARED") // DECLARED | CLAIMED
  txHash         String?
  createdAt      DateTime  @default(now())
  claimedAt      DateTime?

  @@unique([contestId, role]) // one winner per role per contest
  @@unique([contestId, contestEntryId]) // one bonus per entry per contest -- no multi-role sweeps
}

// --- CoinVoyage credentials & admin (identical to sibling apps) -----------

model Settings {
  id                          Int      @id @default(1)
  coinVoyageApiKey            String?
  coinVoyageApiSecret         String?
  coinVoyageEnv               String?
  coinVoyageWebhookSecret     String?
  robinhoodRpcUrl             String?
  robinhoodOperatorPrivateKey String? // signs claim vouchers -- never returned by any API/admin view
  robinhoodRelayerPrivateKey  String? // pays gas to relay claim() on a winner's behalf -- never returned by any API/admin view; deliberately separate from robinhoodOperatorPrivateKey (that one only signs, never broadcasts)
  robinhoodContractAddress    String?
  robinhoodCentsPerTestnetEth Int? // bookkeeping conversion rate only; no real exchange rate backs testnet ETH

  // Sitewide kill switch -- blocks new contest entries, league joins, and
  // live-bet placement (not claims/payouts, so money already owed still
  // moves). Checked at the top of each write route via
  // lib/platform-settings.ts.
  bettingFrozen        Boolean @default(false)
  bettingFrozenMessage String?

  // Fallback defaults for new-contest creation (app/api/admin/contests) and
  // live-bet stake bounds (app/api/live-bets) when the caller/admin doesn't
  // specify its own value. Null means "use the hardcoded fallback" -- see
  // lib/platform-settings.ts.
  defaultRakeBps         Int?
  defaultMinEntriesToRun Int?
  defaultRoleBonusBps    Int?
  minLiveBetStakeCents   Int?
  maxLiveBetStakeCents   Int?

  updatedAt DateTime @updatedAt
}

// Admin login lockout -- IP-keyed (single shared operator secret, unlike
// UserLoginAttempt above).
model LoginAttempt {
  ip          String    @id
  failCount   Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// --- Live customer-support chat ---------------------------------------------
// Polling-based (same pattern as LiveBet/Match live views, not a websocket),
// so no infra beyond the DB is needed. A thread belongs to either a logged-in
// User (userId) or an anonymous site visitor identified by a client-issued
// guestKey cookie -- exactly one of the two is set, enforced in code like
// Payout's contestEntryId/liveBetId pairing above. Admin has no User row (see
// lib/admin-auth.ts's separate stateless scheme), so ChatMessage.sender is
// the USER/ADMIN discriminator rather than a sender FK.
model ChatThread {
  id            String    @id @default(cuid())
  userId        String?
  guestKey      String?
  status        String    @default("OPEN") // OPEN | CLOSED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?

  @@index([userId])
  @@index([guestKey])
  @@index([status])
}

model ChatMessage {
  id          String   @id @default(cuid())
  threadId    String
  sender      String // USER | ADMIN
  body        String
  createdAt   DateTime @default(now())
  readByAdmin Boolean  @default(false)
  readByUser  Boolean  @default(false)

  @@index([threadId])
}
