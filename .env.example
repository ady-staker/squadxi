# --- Database ---
# Postgres connection string (Neon). Get this from your Neon project's
# connection details after creating a database for this app.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Admin (operator dashboard: /admin) ---
# Single shared operator password -- protects the payout queue, refund
# action, and platform overview. Not a per-admin account system.
ADMIN_PASSWORD=""
# Signs the admin session cookie -- deliberately separate from ADMIN_PASSWORD
# (see lib/admin-auth.ts). Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# --- User accounts (players: signup/login) ---
# Signs user session cookies -- distinct from ADMIN_SESSION_SECRET so a
# leaked player-session secret can never forge an admin session or vice
# versa. Generate one with: openssl rand -hex 32
SESSION_SECRET=""

# --- CoinVoyage: Dashboard > Developers > API Keys ---
# Everything below is optional here -- it's the fallback used until real
# values are set at /admin (Settings), which always wins once configured.
#
# This app has no embedded PayButton widget (contest-entry payment is
# server-side createInvoice(), like dental-site) -- NEXT_PUBLIC_COIN_VOYAGE_API_KEY
# only gates "checkout isn't configured yet" messaging client-side.
NEXT_PUBLIC_COIN_VOYAGE_API_KEY=""
COIN_VOYAGE_API_KEY=""
# Secret: server-only, never expose to the client or commit it
COIN_VOYAGE_API_SECRET=""
# "development" (sandbox -- used for this entire build, see README) or "production"
COIN_VOYAGE_ENV="development"
NEXT_PUBLIC_COIN_VOYAGE_ENV="development"

# --- CoinVoyage: Dashboard > Developers > Webhooks ---
# Shown once when you register the webhook endpoint (app/api/webhooks/coinvoyage)
COIN_VOYAGE_WEBHOOK_SECRET=""

# --- Absolute site URL ---
# Optional -- falls back to https://$VERCEL_URL on Vercel, or localhost:3005
# otherwise. Set explicitly once a custom domain is attached.
SITE_URL=""
